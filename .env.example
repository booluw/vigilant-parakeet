# Public key is compiled into the client bundle (used for pushManager.subscribe).
NUXT_PUBLIC_PUSH_PUBLIC_KEY=

# Secret shared between the cron trigger and the /api/push/tick endpoint.
NUXT_PUSH_TICK_SECRET=

# VAPID keys generated with: npx web-push generate-vapid-keys
# Only the public key needs to be duplicated into NUXT_PUBLIC_PUSH_PUBLIC_KEY.
NUXT_PUSH_VAPID_PUBLIC=
NUXT_PUSH_VAPID_PRIVATE=

# Contact email for the VAPID application server (any reachable address works).
NUXT_PUSH_CONTACT_EMAIL=
